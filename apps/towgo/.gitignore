# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Firebase SERVICE-ACCOUNT keys. These can send push — and call other Firebase
# APIs — on our behalf, so they must never reach the repo. They belong outside
# it entirely; the only place they get uploaded is the Expo dashboard.
#
# NOTE: google-services.json is NOT one of these and is deliberately NOT
# ignored. It is a client config that ships inside the APK, carries no
# secret, and the native build needs it committed.
*-firebase-adminsdk-*.json
service-account*.json
serviceAccountKey*.json
