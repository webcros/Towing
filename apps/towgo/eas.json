{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview"
    },
    "production": {
      "autoIncrement": true,
      "channel": "production"
    },
    "demo": {
      "extends": "preview",
      "environment": "development",
      "env": {
        "EXPO_PUBLIC_USE_MOCKS": "true"
      },
      "channel": "demo"
    }
  },
  "submit": {
    "production": {}
  }
}
